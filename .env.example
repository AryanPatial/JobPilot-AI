# Copy to .env and fill in. .env is gitignored — never commit it.
# call_llm() is the single provider swap point; flip LLM_PROVIDER to change backends.
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODELS=gpt-4.1-mini,gpt-4o

GOOGLE_API_KEY=AIza...
GOOGLE_API_KEYS=AIza...,AIza...
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
